{
  "name": "@repo/shared",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./api": {
      "react-native": "./src/services/api.native.js",
      "import": "./src/services/api.js",
      "default": "./src/services/api.js"
    },
    "./syncqueue": {
      "react-native": "./src/services/syncqueue.native.js",
      "import": "./src/services/syncqueue.js",
      "default": "./src/services/syncqueue.js"
    },
    "./src/services/api.native": {
      "import": "./src/services/api.native.js",
      "default": "./src/services/api.native.js"
    },
    "./src/services/syncqueue.native": {
      "import": "./src/services/syncqueue.native.js",
      "default": "./src/services/syncqueue.native.js"
    },
    "./services/crmApiService": {
      "import": "./src/services/crmApiService.js",
      "default": "./src/services/crmApiService.js"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "axios": "^1.7.2"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@react-native-community/netinfo": "*"
  }
