{
  "compilerOptions": {
    "checkJs": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "5.0",
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.mjs",
    "server.js",
    "seed.js"
  ],
  "exclude": [
    "node_modules",
    "SRC",
    "**/SRC/**"
  ]
}
