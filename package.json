{
  "name": "monorapo-accountingapp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run dev --workspaces --if-present",
    "mobile": "npm run start --workspace=apps/mobile -- --lan --clear",
    "desktop": "npm run electron:dev --workspace=apps/desktop",
    "web": "npm run dev --workspace=apps/web",
    "backend": "npm run dev --workspace=apps/backend",
    "dev:all": "npx concurrently \"npm run backend\" \"npm run web\" \"npm run mobile\"",
    "install:all": "npm install --workspaces --if-present",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build:android --workspace=apps/mobile",
    "audit:health": "node scan-project-health.js",
    "audit:repo": "node scripts/Full-repo-audit.js",
    "audit:shared": "node scripts/audit-shared-usage.js",
    "audit:all": "npm run audit:health && npm run audit:repo && npm run audit:shared"
  },
  "dependencies": {
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "supabase": "^2.114.0"
  }
}
